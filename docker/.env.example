# ccledger VPS mode — copy to `.env` and fill in.
#
#   cp .env.example .env
#   docker compose up -d
#
# `.env` is gitignored. This file is the template and holds no real values.

# The domain teammates will reach the dashboard and the ingest endpoint on.
# Its A record must already point at this host: Caddy proves control of the
# name over port 80 to get the certificate, and cannot do that before DNS
# resolves here. No scheme and no trailing slash — just the name.
CCLEDGER_DOMAIN=ccledger.example.com

# Where Let's Encrypt sends certificate expiry warnings. Only used if renewal
# stops working, which is exactly when it matters that this is a real address
# somebody reads.
CCLEDGER_ACME_EMAIL=you@example.com

# IANA zone that alert day and week windows are aligned to — a "weekly" budget
# resets at midnight on Monday in this zone. Set it to where the team actually
# is; UTC is the default and is a defensible answer for a distributed one.
#
# Worth getting right at install: changing it later moves every window
# boundary, and a budget that has already fired this week can fire again.
CCLEDGER_TIMEZONE=UTC
