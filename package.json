{
  "name": "@thisissbk/ccledger",
  "version": "0.1.2",
  "private": false,
  "description": "Self-hosted Claude Code usage dashboard that ingests OpenTelemetry log events into SQLite.",
  "license": "MIT",
  "author": "Shakib Bin Kabir",
  "homepage": "https://github.com/shakibbinkabir/ccledger#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shakibbinkabir/ccledger.git"
  },
  "bugs": {
    "url": "https://github.com/shakibbinkabir/ccledger/issues"
  },
  "keywords": [
    "claude-code",
    "opentelemetry",
    "otlp",
    "telemetry",
    "token-usage",
    "usage-dashboard",
    "self-hosted",
    "sqlite",
    "cli"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "ccledger": "./dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build --config web/vite.config.ts",
    "build:server": "node scripts/build.mjs && node scripts/copy-assets.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "npm run build && node dist/cli/index.js serve",
    "dev:web": "vite --config web/vite.config.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "better-sqlite3": "^13.0.3",
    "bonjour-service": "^1.4.4",
    "commander": "^15.0.0",
    "fastify": "^5.12.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
