{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,

    "outDir": "dist",
    "declaration": true,
    "sourceMap": true
  },
  // `test/` is in scope so the cross-cutting integration test is type-checked by
  // `npm run typecheck`; without it `tsc --noEmit` passes on code it never read.
  // `rootDir` therefore lives in `tsconfig.build.json`, which is the only config
  // that emits and the only one whose file set is `src/` alone.
  "include": ["src", "test"],
  "exclude": ["node_modules", "dist", "web"]
}
